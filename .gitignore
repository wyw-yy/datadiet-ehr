# ---- 环境与依赖（都可重建，不进仓库） ----
.venv/
__pycache__/
*.pyc
*.whl

# ---- 模型权重（9 GB，来自 ModelScope，不进仓库） ----
models/

# ---- 原始数据（可从公开地址重新下载，不进仓库） ----
data/raw/

# ---- MIMIC 派生文本：含病历原文，按 DUA **禁止**入库 ----
data/processed_mimic/
data/raw/mimic*/
# 演练用的合成病历产物（假数据，但同样是病历格式，别混进来）
data/processed_mimic_fake/

# ---- 运行时缓存（激活、分词缓存，几百 MB，脚本可重建） ----
cache/
data/cache/
*.parts/

# ---- 日志与临时文件 ----
*.log
nohup.out
tools/progress_*.json

# ---- 系统 ----
Thumbs.db
desktop.ini
.DS_Store

# 注意：以下内容**要**进仓库，它们是可复现的最小证据集
#   data/processed/   统一后的 JSONL（约 14 MB）
#   data/subsets/     选中的 id 列表（几百 KB）
#   results/          逐题预测、指标表、审计 JSON（几十 MB）
#   paper/            图与表
#   audit/            哈希清单与选择日志

# 软著 PDF 体积大、可随时重生成（tools/make_softcopyright.py + tools/txt_to_pdf.ps1）
softcopyright/*.pdf

# ---- 模型权重与激活（GB 级，脚本可重建，绝不入库） ----
*.safetensors
*.npz
adapters_round*/
acts_round*/

# ---- 临时与办公软件锁文件 ----
tmp/
~\$*

# ---- 归档轮次的池子副本（可由 prepare_data.py 用同样 seed 重建）；
# 注意 results_round*/ 仍要入库：它们是 fig02/fig06 背后的逐题预测与指标表 ----
processed_round*/
data/processed_round*/

# ---- 打出来的发布包（可由 tools/make_release.py 重建，24 MB） ----
dist/

# ---- 日志的其它后缀（gh 登录、pip 之类） ----
*.err
logs/

# 挑战杯通知原文与附件（第三方文件，49 MB，只留本地参考）
docs/challenge_b/notice/
